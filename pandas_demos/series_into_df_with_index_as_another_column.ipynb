   "source": [
    "# importing pandas package\n",
    "import pandas as pd\n",
    "\n",
    "# Creating Series of\n",
    "# programming languages\n",
    "s = pd.Series(['C', 'C++', 'Java',\n",
    "\t\t\t'Python', 'Perl', 'Ruby',\n",
    "\t\t\t'Julia'])\n",
    "\n",
    "s\n",
    "df = s.to_frame().reset_index()\n",
    "df\n",
    "df.rename(columns = {'index':'new_index'},inplace = True)\n",
    "df"
